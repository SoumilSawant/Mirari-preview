# Node 24+. Local demo is explicitly enabled; no real payments or emails.
PORT=4173
HOST=127.0.0.1
APP_URL=http://127.0.0.1:4173
APP_MODE=demo
DATABASE_PATH=data/mirari.sqlite
# Put uploads and the database on persistent storage when deployed.
UPLOADS_PATH=assets/uploads
# Set these for an admin account; otherwise a random local account is generated.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Generate with npm run mfa-secret, enrol in an authenticator, and retain securely.
ADMIN_TOTP_SECRET=
# Exact CIDR(s) of the reverse proxy that connects to Node; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# On Render only, TRUSTED_PROXY_HOPS=1 can replace CIDRs. Verify /api/admin/network
# from two different networks before opening sales so rate limits use customer IPs.
TRUSTED_PROXY_HOPS=
# NODE_ENV controls deployment security settings, not the payment mode.
# For Stripe test staging: APP_MODE=stripe-test, DATABASE_PATH=data/mirari-staging.sqlite,
# a test Stripe key and webhook secret. Use a separate database from demo.
# For LOCAL Stripe testing, `npm run dev:stripe` starts the CLI listener and app
# together, checks that the CLI and test key belong to the same account, and uses
# the CLI's current signing secret for that process. Keep its terminal open.
NODE_ENV=development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated eligible synchronous methods. Card includes device wallets.
STRIPE_PAYMENT_METHODS=card
# Default 0 verifies Stripe on every admission scan; raising it allows a short stale-state window (max 5000 ms).
PAYMENT_CHECKIN_MAX_AGE_MS=0
RESEND_API_KEY=
EMAIL_FROM=
# Live deployment only: use a NEW persistent database and live Stripe webhook.
# Do not set these in demo or Stripe test deployments. Keep false until the owner
# approves final policies and real provider/email end-to-end checks pass.
ENABLE_LIVE_PAYMENTS=false
LIVE_POLICIES_APPROVED=false
STRIPE_ACCOUNT_ID=
# Before filling these, review Admin → Email outbox. Eligible pending Stripe
# test messages are sent automatically after restart; old demo mail stays held.
# Start a single Node instance with a persistent DATABASE_PATH. For live mode,
# APP_MODE=stripe-live, NODE_ENV=production, HTTPS APP_URL, sk_live_ key,
# live webhook secret, verified Resend sender and owner approvals are required.
# Remove any legacy DEMO_MODE variable before using APP_MODE=stripe-live.
